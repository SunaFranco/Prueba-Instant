# ==============================================================================
# Environment Configuration - Instant Movie Recommendation System
# ==============================================================================

# Backend API Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=super-secret-jwt-and-flask-key-change-in-production-12345
JWT_EXPIRATION_HOURS=24

# Supabase Configuration
# Puedes obtener estas claves en tu panel de Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# External APIs
# TMDB API (The Movie Database): https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Groq Cloud API: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Redis & Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
RECOMMENDATION_QUEUE_NAME=recommendation_jobs

# Rate Limiter Configuration for Groq
GROQ_MAX_REQUESTS_PER_MINUTE=20
GROQ_RETRY_MAX_ATTEMPTS=5

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
